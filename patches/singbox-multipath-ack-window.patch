+func (c *mpCore) queueStalledWriteFallback(frames []wireFrame) {
+	sort.Slice(frames, func(i, j int) bool { return frames[i].seq < frames[j].seq })
+	ticker := time.NewTicker(time.Millisecond)
+	defer ticker.Stop()
+	for _, frame := range frames {
+		for {
+			if c.isDone() {
+				c.putBuffer(frame.data)
+				break
+			}
+			leg0 := c.getLeg(0)
+			if leg0 == nil {
+				c.putBuffer(frame.data)
+				c.fail(errors.New("multipath control leg unavailable during stalled-write fallback"))
+				return
+			}
+			if leg0.tryQueue(frame, c.cfg.QueueBytes) {
+				break
+			}
+			select {
+			case <-c.done:
+				c.putBuffer(frame.data)
+				return
+			case <-ticker.C:
+			}
+		}
+	}
+}
