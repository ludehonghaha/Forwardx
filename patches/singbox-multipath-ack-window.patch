+func (c *mpCore) markReplayWriteStarted(seq uint64) bool {
+	c.replayMu.Lock()
+	entry := c.replay[seq]
+	if entry == nil {
+		c.replayMu.Unlock()
+		return false
+	}
+	if entry.acked {
+		delete(c.replay, seq)
+		c.replayBytes -= int64(len(entry.frame.data))
+		c.replayMu.Unlock()
+		return false
+	}
+	if entry.writeStartedAt.IsZero() {
+		entry.writeStartedAt = time.Now()
+	}
+	c.replayMu.Unlock()
+	return true
+}
