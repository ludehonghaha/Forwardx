+func (c *mpCore) sendWindowFrames() uint64 {
+	// ACKs describe the receiver's next contiguous sequence. Bound the number
+	// of later frames that can be emitted so one slow leg cannot make the other
+	// leg overflow the receiver's reorder limits.
+	frames := c.cfg.QueueFrames
+	if c.cfg.MaxReorderFrames < frames {
+		frames = c.cfg.MaxReorderFrames
+	}
+	if byteFrames := int(c.cfg.MaxReorderBytes / int64(c.cfg.ChunkSize)); byteFrames < frames {
+		frames = byteFrames
+	}
+	if frames < 1 {
+		frames = 1
+	}
+	return uint64(frames)
+}
